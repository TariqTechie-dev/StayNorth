<nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
  <div class="container-fluid navbar-shell">
    <a class="navbar-brand" href="/listings"><img src="/images/logo.svg" alt="StayNorth logo" class="navbar-logo">StayNorth</a>
    <div class="navbar-search-wrap">
      <form class="navbar-search" role="search" action="/listings" method="GET">
        <% if (typeof selectedCategory !== "undefined" && selectedCategory !== "all") { %>
          <input type="hidden" name="category" value="<%= selectedCategory %>">
        <% } %>
        <input
          type="text"
          name="search"
          class="navbar-search-input"
          placeholder="Search destinations..."
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          aria-label="Search listings"
        >
        <button class="navbar-search-btn" type="submit" aria-label="Search listings">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>
    </div>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav me-auto">
        <a class="nav-link" href="/listings" title="Browse all stays"><i class="fa-solid fa-compass nav-ico"></i>Explore</a>
      </div>

      <div class="navbar-nav ms-auto">
         <a class="nav-link" href="/listings/new" title="List your property on StayNorth"><i class="fa-solid fa-plus nav-ico"></i>List your stay</a>
        <%if (!currentUser) { %>
        <a class="nav-link " href="/signup" title="Create a new account"><i class="fa-solid fa-user-plus nav-ico"></i><b>Signup</b></a>
        <a class="nav-link" href="/login" title="Log in to your account"><i class="fa-solid fa-right-to-bracket nav-ico"></i><b>Login</b></a>
       <% } %> 
       <% if(currentUser) {%>
        <a class="nav-link" href="/bookings" title="View your upcoming trips"><i class="fa-solid fa-suitcase-rolling nav-ico"></i>My Trips</a>
        <a class="nav-link" href="/bookings/manage" title="Manage bookings on your listings"><i class="fa-solid fa-calendar-check nav-ico"></i>Manage Bookings</a>
        <a class="nav-link" href="/logout" title="Log out of StayNorth"><i class="fa-solid fa-right-from-bracket nav-ico"></i><b>Logout</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
