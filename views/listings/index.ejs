<% layout("layouts/boilerplate") %>



<div class="container-fluid">
  <div class="index-filter-bar">
    <div class="filter-carousel">
      <button class="filter-arrow filter-arrow-left" type="button" aria-label="Show previous filters">
        <i class="fa-solid fa-chevron-left"></i>
      </button>

      <div class="filter-scroll" aria-label="Listing categories">
        <a href="/listings" class="filter-item <%= selectedCategory === 'all' ? 'active' : '' %>">
          <i class="fa-solid fa-border-all"></i>
          <span>All</span>
        </a>
        <a href="/listings?category=trending" class="filter-item <%= selectedCategory === 'trending' ? 'active' : '' %>">
          <i class="fa-solid fa-fire"></i>
          <span>Trending</span>
        </a>
        <a href="/listings?category=rooms" class="filter-item <%= selectedCategory === 'rooms' ? 'active' : '' %>">
          <i class="fa-solid fa-bed"></i>
          <span>Rooms</span>
        </a>
        <a href="/listings?category=iconic-cities" class="filter-item <%= selectedCategory === 'iconic-cities' ? 'active' : '' %>">
          <i class="fa-solid fa-city"></i>
          <span>Iconic cities</span>
        </a>
        <a href="/listings?category=mountains" class="filter-item <%= selectedCategory === 'mountains' ? 'active' : '' %>">
          <i class="fa-solid fa-mountain-sun"></i>
          <span>Mountains</span>
        </a>
        <a href="/listings?category=castles" class="filter-item <%= selectedCategory === 'castles' ? 'active' : '' %>">
          <i class="fa-brands fa-fort-awesome"></i>
          <span>Castles</span>
        </a>
        <a href="/listings?category=amazing-pools" class="filter-item <%= selectedCategory === 'amazing-pools' ? 'active' : '' %>">
          <i class="fa-solid fa-person-swimming"></i>
          <span>Amazing pools</span>
        </a>
        <a href="/listings?category=camping" class="filter-item <%= selectedCategory === 'camping' ? 'active' : '' %>">
          <i class="fa-solid fa-campground"></i>
          <span>Camping</span>
        </a>
        <a href="/listings?category=farms" class="filter-item <%= selectedCategory === 'farms' ? 'active' : '' %>">
          <i class="fa-solid fa-tractor"></i>
          <span>Farms</span>
        </a>
        <a href="/listings?category=arctic" class="filter-item <%= selectedCategory === 'arctic' ? 'active' : '' %>">
          <i class="fa-solid fa-snowflake"></i>
          <span>Arctic</span>
        </a>
        <a href="/listings?category=boats" class="filter-item <%= selectedCategory === 'boats' ? 'active' : '' %>">
          <i class="fa-solid fa-sailboat"></i>
          <span>Boats</span>
        </a>
      </div>

      <button class="filter-arrow filter-arrow-right" type="button" aria-label="Show more filters">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>

    <div class="listing-filter-actions">
      <label class="tax-toggle" for="taxSwitch">
        <span>Prices include 16% GST</span>
        <input class="tax-toggle-input" type="checkbox" id="taxSwitch">
        <span class="tax-toggle-slider" aria-hidden="true"></span>
      </label>
    </div>
  </div>

  <div class="row g-6">

    <% for(let listing of alllistings){ %>

    <div class="col-12 col-sm-6 col-lg-4">
      <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">

        <div class="card h-100 listing-card">
          <img src="<%= listing.image.url %>" class="card-img-top listing-index-img" alt="Listing_image">
          <div class="card-img-overlay"></div>

          <div class="card-body">
            <p class="card-text">
              <b>
                <%= listing.title %>
              </b><br>
              <span class="listing-price" data-base-price="<%= listing.price %>">Rs <%= listing.price.toLocaleString("en-PK") %>/night</span>
            </p>
          </div>
        </div>

      </a>
    </div>

    <% } %>

  </div>
</div>
