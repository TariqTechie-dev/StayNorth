<% layout("layouts/boilerplate") %>
<% const searchQs = searchQuery ? `search=${encodeURIComponent(searchQuery)}` : ""; %>



<div class="container-fluid">
  <% if (!searchQuery && selectedCategory === "all") { %>
    <div class="hero-strip text-center py-4 px-3 mt-3">
      <h1 class="fw-bold">Find your perfect stay in Northern Pakistan</h1>
      <p class="text-muted mb-0">From Hunza valleys to Naran meadows — book unique stays directly from local hosts.</p>
    </div>
  <% } %>

  <div class="index-filter-bar">
    <div class="filter-carousel">
      <button class="filter-arrow filter-arrow-left" type="button" aria-label="Show previous filters">
        <i class="fa-solid fa-chevron-left"></i>
      </button>

      <div class="filter-scroll" aria-label="Listing categories">
        <a href="/listings<%= searchQs ? `?${searchQs}` : "" %>" class="filter-item <%= selectedCategory === 'all' ? 'active' : '' %>">
          <i class="fa-solid fa-border-all"></i>
          <span>All</span>
        </a>
        <a href="/listings?category=trending<%= searchQs ? `&${searchQs}` : "" %>" class="filter-item <%= selectedCategory === 'trending' ? 'active' : '' %>">
          <i class="fa-solid fa-fire"></i>
          <span>Trending</span>
        </a>
        <a href="/listings?category=rooms<%= searchQs ? `&${searchQs}` : "" %>" class="filter-item <%= selectedCategory === 'rooms' ? 'active' : '' %>">
          <i class="fa-solid fa-bed"></i>
          <span>Rooms</span>
        </a>
        <a href="/listings?category=iconic-cities<%= searchQs ? `&${searchQs}` : "" %>" class="filter-item <%= selectedCategory === 'iconic-cities' ? 'active' : '' %>">
          <i class="fa-solid fa-city"></i>
          <span>Iconic cities</span>
        </a>
        <a href="/listings?category=mountains<%= searchQs ? `&${searchQs}` : "" %>" class="filter-item <%= selectedCategory === 'mountains' ? 'active' : '' %>">
          <i class="fa-solid fa-mountain-sun"></i>
          <span>Mountains</span>
        </a>
        <a href="/listings?category=castles<%= searchQs ? `&${searchQs}` : "" %>" class="filter-item <%= selectedCategory === 'castles' ? 'active' : '' %>">
          <i class="fa-brands fa-fort-awesome"></i>
          <span>Castles</span>
        </a>
        <a href="/listings?category=amazing-pools<%= searchQs ? `&${searchQs}` : "" %>" class="filter-item <%= selectedCategory === 'amazing-pools' ? 'active' : '' %>">
          <i class="fa-solid fa-person-swimming"></i>
          <span>Amazing pools</span>
        </a>
        <a href="/listings?category=camping<%= searchQs ? `&${searchQs}` : "" %>" class="filter-item <%= selectedCategory === 'camping' ? 'active' : '' %>">
          <i class="fa-solid fa-campground"></i>
          <span>Camping</span>
        </a>
        <a href="/listings?category=farms<%= searchQs ? `&${searchQs}` : "" %>" class="filter-item <%= selectedCategory === 'farms' ? 'active' : '' %>">
          <i class="fa-solid fa-tractor"></i>
          <span>Farms</span>
        </a>
        <a href="/listings?category=arctic<%= searchQs ? `&${searchQs}` : "" %>" class="filter-item <%= selectedCategory === 'arctic' ? 'active' : '' %>">
          <i class="fa-solid fa-snowflake"></i>
          <span>Arctic</span>
        </a>
        <a href="/listings?category=boats<%= searchQs ? `&${searchQs}` : "" %>" class="filter-item <%= selectedCategory === 'boats' ? 'active' : '' %>">
          <i class="fa-solid fa-sailboat"></i>
          <span>Boats</span>
        </a>
      </div>

      <button class="filter-arrow filter-arrow-right" type="button" aria-label="Show more filters">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>

    <div class="listing-filter-actions">
      <label class="tax-toggle" for="taxSwitch">
        <span>Prices include 16% GST</span>
        <input class="tax-toggle-input" type="checkbox" id="taxSwitch">
        <span class="tax-toggle-slider" aria-hidden="true"></span>
      </label>
    </div>
  </div>

  <% if (searchQuery) { %>
    <div class="d-flex align-items-center justify-content-between mt-3 mb-2">
      <p class="mb-0 text-muted">Showing results for <strong><%= searchQuery %></strong></p>
      <a href="/listings" class="btn btn-sm btn-outline-dark">Clear search</a>
    </div>
  <% } %>

  <% if (alllistings.length === 0) { %>
    <div class="text-center py-5">
      <h4>No stays found</h4>
      <p class="text-muted">Try a different destination or <a href="/listings">browse all stays</a>.</p>
    </div>
  <% } %>

  <div class="row gx-4 gy-4">

    <% for(let listing of alllistings){ %>

    <div class="col-12 col-sm-6 col-lg-4">
      <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">

        <div class="card h-100 listing-card">
          <img src="<%= listing.image.url %>" class="card-img-top listing-index-img" alt="<%= listing.title %>">

          <div class="card-body">
            <p class="card-text">
              <b>
                <%= listing.title %>
              </b><br>
              <small class="text-muted"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></small><br>
              <span class="listing-price" data-base-price="<%= listing.price %>">Rs <%= listing.price.toLocaleString("en-PK") %>/night</span>
            </p>
          </div>
        </div>

      </a>
    </div>

    <% } %>

  </div>
</div>
