<% layout("layouts/boilerplate") %>

<div class="row">
  <div class="col-12 col-sm-10 col-md-8 offset-sm-1 offset-md-2">
    <h1 class="mt-4 mb-1">Create New Listing</h1>
    <form method="post" action="/listings"  novalidate class="needs-validation" enctype="multipart/form-data">

      <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input type="text" name="listing[title]" id="title" placeholder="Enter your title" required class="form-control">
          <div class="valid-feedback">Title looks good!</div>
          <div class="invalid-feedback"> Please provide a title</div>
      </div>


      <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea name="listing[description]" id="description" placeholder="Enter your description" required class="form-control"></textarea>
            <div class="valid-feedback">Description looks good!</div>
            <div class="invalid-feedback"> Please provide a description</div>
      </div>

     
      <div class="mb-3">
          <label for="image" class="form-label">Upload listing image</label>
          <input type="file" name="listing[image]" id="image" required accept="image/*" class="form-control">
          <div class="invalid-feedback">Please choose an image for your listing</div>
      </div>

      <div class="row">
        <div class="mb-3 col-12 col-md-4">
           <label for="price" class="form-label">Price</label>
           <input type="number" name="listing[price]" id="price" placeholder="Enter your price" min="0" required class="form-control">
            <div class="valid-feedback">Price looks good!</div>
            <div class="invalid-feedback"> Please provide a valid price</div>
        </div>

        <div class="mb-3 col-12 col-md-8">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" id="location" placeholder="Enter location" required class="form-control">
              <div class="valid-feedback">Location looks good!</div>
              <div class="invalid-feedback"> Please provide a location</div>
        </div>

            <div class="mb-3 col-12">
              <label for="country" class="form-label">Country</label>
              <input type="text" name="listing[country]" id="country" placeholder="Enter country" required class="form-control">
              <div class="valid-feedback">Country looks good!</div>
              <div class="invalid-feedback"> Please provide a country name</div>
            </div>

            <div class="mb-3 col-12">
              <label for="category" class="form-label">Category</label>
              <select name="listing[category]" id="category" required class="form-select">
                <option value="" disabled selected>Select a category</option>
                <option value="trending">Trending</option>
                <option value="rooms">Rooms</option>
                <option value="iconic-cities">Iconic Cities</option>
                <option value="mountains">Mountains</option>
                <option value="castles">Castles</option>
                <option value="amazing-pools">Amazing Pools</option>
                <option value="camping">Camping</option>
                <option value="farms">Farms</option>
                <option value="arctic">Arctic</option>
                <option value="boats">Boats</option>
              </select>
              <div class="invalid-feedback">Please select a category</div>
            </div>
      </div>


      <button type="submit" class="btn btn-brand add-btn w-100 mt-2 mb-5">Add listing</button>
    </form>
  </div>
</div>