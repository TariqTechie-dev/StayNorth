<% layout("layouts/boilerplate") %>

<div class="row mt-3 mt-md-4 mb-4 g-3">
  <div class="col-12 col-md-8 offset-md-2">
    <h3>
      <%= listing.title %>
    </h3>
  </div>

  <div class="col-12 col-md-8 offset-md-2">
    <span class="badge bg-dark d-inline-block mb-2"><%= (listing.category || "trending").replace(/-/g, " ") %></span>
    <div class="card h-100 listing-card">
      <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="<%= listing.title %>" />
      <div class="card-body">
        <p class="text-muted mb-1">
          <i class="fa-solid fa-location-dot"></i>
          <%= listing.location %>, <%= listing.country %>
        </p>
        <% if (listing.reviews.length > 0) { %>
          <% const avgRating = (listing.reviews.reduce((sum, r) => sum + r.rating, 0) / listing.reviews.length).toFixed(1); %>
          <p class="mb-2">
            <i class="fa-solid fa-star" style="color: #fe424d;"></i>
            <strong><%= avgRating %></strong>
            <span class="text-muted">· <%= listing.reviews.length %> review<%= listing.reviews.length > 1 ? "s" : "" %></span>
          </p>
        <% } %>
        <h4 class="fw-bold mb-2">Rs <%= listing.price.toLocaleString("en-PK") %> <span class="text-muted fs-6 fw-normal">/ night</span></h4>
        <p class="card-text"><%= listing.description %></p>
        <p class="card-text text-muted"><small><i class="fa-solid fa-circle-user"></i> Hosted by <i><%= listing.owner.username %></i></small></p>
      </div>
    </div>
  </div>

  <% if (currentUser && !currentUser._id.equals(listing.owner._id)) { %>
  <div class="col-12 col-md-8 offset-md-2 mb-3">
    <div class="card shadow-sm p-3 p-md-4" id="booking-card" data-price="<%= listing.price %>">
      <h4 class="fs-5 mb-1">Rs <%= listing.price.toLocaleString("en-PK") %> <span class="text-muted fs-6 fw-normal">/ night</span></h4>
      <form action="/listings/<%= listing._id %>/bookings" method="POST" novalidate class="needs-validation">
        <div class="row g-2 mt-2">
          <div class="col-6">
            <label class="form-label" for="checkIn"><i class="fa-solid fa-calendar-days text-muted"></i> Check-in</label>
            <input type="date" id="checkIn" name="booking[checkIn]" class="form-control" required min="<%= new Date().toISOString().split('T')[0] %>">
            <div class="invalid-feedback">Select a check-in date</div>
          </div>
          <div class="col-6">
            <label class="form-label" for="checkOut"><i class="fa-solid fa-calendar-days text-muted"></i> Check-out</label>
            <input type="date" id="checkOut" name="booking[checkOut]" class="form-control" required min="<%= new Date().toISOString().split('T')[0] %>">
            <div class="invalid-feedback">Select a check-out date</div>
          </div>
          <div class="col-12">
            <label class="form-label" for="guests"><i class="fa-solid fa-users text-muted"></i> Guests</label>
            <input type="number" id="guests" name="booking[guests]" class="form-control" value="1" min="1" max="20" required>
            <div class="invalid-feedback">Enter number of guests (1-20)</div>
          </div>
        </div>
        <div class="mt-3">
          <strong id="booking-total" class="text-muted">Select dates to see total</strong>
        </div>
        <button class="btn btn-brand w-100 mt-2">Reserve</button>
      </form>
    </div>
  </div>
  <script>
    (() => {
      const card = document.getElementById("booking-card");
      if (!card) return;
      const pricePerNight = Number(card.dataset.price);
      const checkInEl = document.getElementById("checkIn");
      const checkOutEl = document.getElementById("checkOut");
      const totalEl = document.getElementById("booking-total");
      const updateTotal = () => {
        const checkIn = new Date(checkInEl.value);
        const checkOut = new Date(checkOutEl.value);
        const nights = Math.round((checkOut - checkIn) / 86400000);
        if (checkInEl.value && checkOutEl.value && nights > 0) {
          totalEl.textContent = `Rs ${(nights * pricePerNight).toLocaleString("en-PK")} for ${nights} night${nights > 1 ? "s" : ""}`;
          totalEl.classList.remove("text-muted");
        } else {
          totalEl.textContent = "Select dates to see total";
          totalEl.classList.add("text-muted");
        }
        if (checkInEl.value) checkOutEl.min = checkInEl.value;
      };
      checkInEl.addEventListener("change", updateTotal);
      checkOutEl.addEventListener("change", updateTotal);
    })();
  </script>
  <% } else if (!currentUser) { %>
  <div class="col-12 col-md-8 offset-md-2 mb-3">
    <div class="card shadow-sm p-3 text-center">
      <p class="mb-2">Want to book this stay?</p>
      <a href="/login" class="btn btn-brand">Log in to book</a>
    </div>
  </div>
  <% } %>

  <!-- btn section for edit and delete only for the owner of the listing -->
  <% if(currentUser && currentUser._id.equals(listing.owner._id)) { %>
  <div class="col-12 col-md-8 offset-md-2">
    <div class="btns">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark flex-grow-1 edit-btn">Edit</a>

      <form method="POST" action="/listings/<%= listing._id %>?_method=delete" class="flex-grow-1">
        <button class="btn btn-dark w-100">Delete</button>
      </form>
    </div>
  </div>
  <% } %>

  <div class="col-12 col-md-8 offset-md-2 mb-3 mt-3">
    <% if(currentUser && !currentUser._id.equals(listing.owner._id)) { %>
    <div class="card shadow-sm p-3 p-md-4">
      <h3 class="mb-3 fs-5">Share your experience</h3>
      <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate class="needs-validation">

        <!-- Star Rating -->
        <div class="mb-3">
          <label class="form-label">Rating</label><br>
          <div class="star-rating">
            <label><input type="radio" name="review[rating]" value="5" required><i class="fa-solid fa-star"></i></label>
            <label><input type="radio" name="review[rating]" value="4"><i class="fa-solid fa-star"></i></label>
            <label><input type="radio" name="review[rating]" value="3"><i class="fa-solid fa-star"></i></label>
            <label><input type="radio" name="review[rating]" value="2"><i class="fa-solid fa-star"></i></label>
            <label><input type="radio" name="review[rating]" value="1"><i class="fa-solid fa-star"></i></label>
          </div>
        </div>

        <!-- Comment -->
        <div class="mb-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea name="review[comment]" id="comment" cols="30" rows="4" maxlength="500" class="form-control" required></textarea>
          <div class="invalid-feedback">
            Please submit some comment for review.
          </div>
        </div>

        <button class="btn btn-dark w-100">Submit Review</button>
      </form>
    </div>
    <% } %>

    <!-- All Reviews -->
    <hr class="mt-4 mt-md-5">
    <% if(listing.reviews.length > 0){ %>
    <h4 class="mb-3 fs-6">All Reviews</h4>
    <div class="list-group">
      <% for(let review of listing.reviews) { %>
      <div class="list-group-item">
        <h5 class="mb-1 fs-6">
          <%= review.author.username %>
        </h5>
        <p class="mb-1">
          <%= review.comment %>
        </p>
        <small class="text-muted">
          <% for (let i = 1; i <= 5; i++) { %><i class="fa-solid fa-star" style="color: <%= i <= review.rating ? '#fe424d' : '#e0e0e0' %>;"></i><% } %>
          | Posted on <%= review.createdAt.toDateString() %>
        </small>
        <% if (currentUser && review.author && currentUser._id.equals(review.author._id)) { %>
        <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-2">
          <button class="btn btn-sm btn-outline-danger">Delete</button>
        </form>
        <% } %>
      </div>
      <% } %>
    </div>  <% } %>
  </div>
  
  <div class="col-12 col-md-8 offset-md-2 mb-3">
    <h3 class="mb-3 fs-5">Where you'll be</h3>
    <div id="map" data-location="<%= [listing.location, listing.country].filter(Boolean).join(', ') %>" data-title="<%= listing.title %>"></div>
  </div>
</div>

